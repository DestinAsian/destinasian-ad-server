NODE_ENV=production
HOST=0.0.0.0
PORT=5001

# Production runtime database. Never copy a local or staging database URI here.
MONGO_URI=mongodb://replace-with-production-host:27017/destinasian_adserver
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Generate a unique value for production: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-production-only-value
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
OWNER_SETUP_TOKEN_EXPIRE=1h
TWO_FACTOR_CHALLENGE_EXPIRE=10m
MAX_2FA_ATTEMPTS=5
TWO_FACTOR_LOCK_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
RESET_PASSWORD_RATE_LIMIT_MAX=10
RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
TWO_FACTOR_ISSUER=DestinAsian Ad Server
TWO_FACTOR_WINDOW=1

DASHBOARD_URL=https://admin.destinasian.com
PASSWORD_RESET_BASE_URL=https://admin.destinasian.com
PASSWORD_RESET_EXPIRE_MINUTES=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-production-mailbox
SMTP_PASS=replace-with-production-app-password
MAIL_FROM=DestinAsian Ad Server <replace-with-production-mailbox>

CORS_ORIGIN=https://admin.destinasian.com,https://destinasian.com,https://www.destinasian.com
TRUST_PROXY=1
ENABLE_STATUS_CRON=true
STATUS_CRON_SCHEDULE=*/5 * * * *
