NODE_ENV=development
HOST=0.0.0.0
PORT=5001

MONGO_URI=mongodb://localhost:27017/ad-server
# Optional legacy alias; MONGO_URI takes precedence when both are set.
MONGODB_URI=mongodb://localhost:27017/ad-server
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Generate independently per environment, for example: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-environment-specific-value
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
OWNER_SETUP_TOKEN_EXPIRE=1h
TWO_FACTOR_CHALLENGE_EXPIRE=10m
MAX_2FA_ATTEMPTS=5
TWO_FACTOR_LOCK_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
RESET_PASSWORD_RATE_LIMIT_MAX=10
RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
TWO_FACTOR_ISSUER=DestinAsian Ad Server
TWO_FACTOR_WINDOW=1

DASHBOARD_URL=http://localhost:3000
PASSWORD_RESET_BASE_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=10

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-an-app-password
MAIL_FROM=DestinAsian Ad Server <mailer@example.com>

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5001
TRUST_PROXY=1
ENABLE_STATUS_CRON=true
STATUS_CRON_SCHEDULE=*/5 * * * *
